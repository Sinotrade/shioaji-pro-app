{
  "schema": "execution-conformance-v1",
  "name": "isolation-stale-source-events",
  "description": "P0-1: ticks / heartbeats / reports carry their source env; a late simulation tick after switching to production never drives a production program, and a production result never binds a simulation slot.",
  "covers": [
    "env",
    "isolation",
    "source"
  ],
  "steps": [
    {
      "event": {
        "type": "connection",
        "ts": 1000,
        "live": true,
        "env": "simulation",
        "serverId": "local-a"
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 1001,
        "id": "c1001",
        "command": {
          "op": "create",
          "program": {
            "id": "t1",
            "kind": "trigger",
            "binding": {
              "env": "simulation",
              "serverId": "local-a",
              "account": {
                "accountType": "F",
                "brokerId": "F002000",
                "accountId": "1234567"
              },
              "contract": {
                "market": "futures",
                "quoteCode": "TXFR1",
                "orderCode": "TXFJ6",
                "securityType": "FUT"
              }
            },
            "version": 1,
            "status": "running",
            "pauseReason": null,
            "hold": null,
            "ocoLevels": false,
            "levels": [
              {
                "id": "L1",
                "side": "Sell",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "below",
                  "price": 100,
                  "order": {
                    "priceType": "MKT",
                    "timeInForce": "IOC",
                    "octype": "Auto"
                  }
                },
                "exit": null,
                "phase": "idle",
                "check": null,
                "recross": [],
                "pending": null,
                "orders": [],
                "position": 0,
                "entryFilled": 0,
                "unprotected": 0,
                "cycles": 0,
                "detail": null
              }
            ],
            "generator": null,
            "cycle": {
              "rearmAfterExit": false,
              "maxCycles": null,
              "partialFill": "immediate"
            },
            "bounds": {
              "upper": null,
              "lower": null,
              "onBreakUpper": "none",
              "onBreakLower": "none"
            },
            "session": {
              "resumeRule": "confirm",
              "longDisconnectMs": 60000,
              "silentStallMs": 90000
            },
            "risk": {
              "maxWorkingEntries": null
            },
            "hooks": [],
            "intentSeq": 0,
            "issues": [],
            "createdAt": 0,
            "updatedAt": 0
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 1002,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 99
      },
      "expect": {
        "intents": [
          {
            "kind": "place",
            "key": "simulation/local-a/t1/L1/entry/0/0",
            "action": "Sell",
            "qty": 1,
            "leg": "entry",
            "role": "entry",
            "price": null,
            "env": "simulation"
          }
        ]
      }
    },
    {
      "event": {
        "type": "intentResult",
        "ts": 1003,
        "env": "production",
        "serverId": "local-a",
        "key": "simulation/local-a/t1/L1/entry/0/0",
        "outcome": "accepted",
        "orderId": "x"
      },
      "expect": {
        "programs": {
          "t1": {
            "levels": {
              "L1": {
                "orders": [
                  {
                    "status": "pendingSubmit",
                    "orderId": null
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "intentResult",
        "ts": 1004,
        "env": "simulation",
        "serverId": "local-a",
        "key": "simulation/local-a/t1/L1/entry/0/0",
        "outcome": "accepted",
        "orderId": "o1"
      },
      "expect": {
        "programs": {
          "t1": {
            "levels": {
              "L1": {
                "orders": [
                  {
                    "status": "working",
                    "orderId": "o1"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "connection",
        "ts": 2000,
        "live": true,
        "env": "production",
        "serverId": "local-a"
      },
      "expect": {
        "notices": [
          "held"
        ],
        "programs": {
          "t1": {
            "hold": "envMismatch"
          }
        }
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 2001,
        "id": "c2001",
        "command": {
          "op": "create",
          "program": {
            "id": "p1",
            "kind": "trigger",
            "binding": {
              "env": "production",
              "serverId": "local-a",
              "account": {
                "accountType": "F",
                "brokerId": "F002000",
                "accountId": "1234567"
              },
              "contract": {
                "market": "futures",
                "quoteCode": "TXFR1",
                "orderCode": "TXFJ6",
                "securityType": "FUT"
              }
            },
            "version": 1,
            "status": "running",
            "pauseReason": null,
            "hold": null,
            "ocoLevels": false,
            "levels": [
              {
                "id": "L1",
                "side": "Sell",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "below",
                  "price": 100,
                  "order": {
                    "priceType": "MKT",
                    "timeInForce": "IOC",
                    "octype": "Auto"
                  }
                },
                "exit": null,
                "phase": "idle",
                "check": null,
                "recross": [],
                "pending": null,
                "orders": [],
                "position": 0,
                "entryFilled": 0,
                "unprotected": 0,
                "cycles": 0,
                "detail": null
              }
            ],
            "generator": null,
            "cycle": {
              "rearmAfterExit": false,
              "maxCycles": null,
              "partialFill": "immediate"
            },
            "bounds": {
              "upper": null,
              "lower": null,
              "onBreakUpper": "none",
              "onBreakLower": "none"
            },
            "session": {
              "resumeRule": "confirm",
              "longDisconnectMs": 60000,
              "silentStallMs": 90000
            },
            "risk": {
              "maxWorkingEntries": null
            },
            "hooks": [],
            "intentSeq": 0,
            "issues": [],
            "createdAt": 0,
            "updatedAt": 0
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 2002,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 90
      },
      "expect": {
        "programs": {
          "p1": {
            "levels": {
              "L1": {
                "phase": "idle"
              }
            }
          }
        },
        "state": {
          "lastPrices": {}
        }
      }
    },
    {
      "event": {
        "type": "heartbeat",
        "ts": 2003,
        "env": "simulation",
        "serverId": "local-a"
      },
      "expect": {
        "state": {
          "lastActivity": 2000
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 2004,
        "env": "production",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 99
      },
      "expect": {
        "intents": [
          {
            "kind": "place",
            "key": "production/local-a/p1/L1/entry/0/0",
            "action": "Sell",
            "qty": 1,
            "leg": "entry",
            "role": "entry",
            "price": null,
            "env": "production"
          }
        ]
      }
    },
    {
      "event": {
        "type": "deal",
        "ts": 2005,
        "env": "simulation",
        "serverId": "local-a",
        "orderId": "o1",
        "eventId": null,
        "seq": "s1",
        "account": {
          "brokerId": "F002000",
          "accountId": "1234567"
        },
        "code": "TXFJ6",
        "action": "Sell",
        "qty": 1,
        "price": 99,
        "fillTs": 2.005
      },
      "expect": {
        "programs": {
          "t1": {
            "levels": {
              "L1": {
                "phase": "done",
                "orders": [
                  {
                    "filled": 1
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
