        "programs": {
          "t1": {
            "levels": {
              "L1": {
                "phase": "needsConfirm",
                "pending": {
                  "reason": "env"
                }
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "intentResult",
