                "phase": "idle"
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "connection",
        "ts": 3000,
        "live": true,
        "env": "simulation",
        "serverId": "local-a"
      },
      "expect": {
        "programs": {
          "t1": {
            "hold": null,
            "levels": {
              "L1": {
                "check": "env"
              }
            }
          },
          "p1": {
            "hold": "envMismatch"
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 3001,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
