            "pauseReason": null,
            "hold": null,
            "ocoLevels": false,
            "levels": [
              {
                "id": "L1",
                "side": "Sell",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "below",
                  "price": 100,
                  "order": {
                    "priceType": "MKT",
                    "timeInForce": "IOC",
                    "octype": "Auto"
                  }
                },
                "exit": null,
