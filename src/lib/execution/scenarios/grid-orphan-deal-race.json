      "expect": {
        "intents": [
          {
            "kind": "place",
            "key": "simulation/local-a/g1/L1/tp/0/1",
            "action": "Sell",
            "qty": 1,
            "leg": "tp",
            "role": "exit",
            "price": 100
          }
        ],
        "state": {
          "orphanDeals": []
        },
        "programs": {
          "g1": {
            "levels": {
              "L1": {
                "phase": "exiting",
                "position": 1
              }
            }
          }
        }
      }
    }
  ]
}
