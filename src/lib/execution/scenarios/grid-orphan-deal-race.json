{
  "schema": "execution-conformance-v1",
  "name": "grid-orphan-deal-race",
  "description": "A deal that arrives before the submit response is buffered and applied once the order id is known.",
  "covers": [
    "grid",
    "dedupe"
  ],
  "steps": [
    {
      "event": {
        "type": "connection",
        "ts": 1000,
        "live": true,
        "env": "simulation",
        "serverId": "local-a"
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 1001,
        "id": "c1001",
        "command": {
          "op": "create",
          "program": {
            "id": "g1",
            "kind": "grid",
            "binding": {
              "env": "simulation",
              "serverId": "local-a",
              "account": {
                "accountType": "F",
                "brokerId": "F002000",
                "accountId": "1234567"
              },
              "contract": {
                "market": "futures",
                "quoteCode": "TXFR1",
                "orderCode": "TXFJ6",
                "securityType": "FUT"
              }
            },
            "version": 1,
            "status": "running",
            "pauseReason": null,
            "hold": null,
            "ocoLevels": false,
            "levels": [
              {
                "id": "L1",
                "side": "Buy",
                "qty": 1,
                "entry": {
                  "type": "limit",
                  "price": 99,
                  "order": {
                    "priceType": "LMT",
                    "timeInForce": "ROD",
                    "octype": "New"
                  }
                },
                "exit": {
                  "type": "takeProfit",
                  "price": 100,
                  "order": {
                    "priceType": "LMT",
                    "timeInForce": "ROD",
                    "octype": "Cover"
                  }
                },
                "phase": "idle",
                "check": null,
                "recross": [],
                "pending": null,
                "orders": [],
                "position": 0,
                "entryFilled": 0,
                "unprotected": 0,
                "cycles": 0,
                "detail": null
              }
            ],
            "generator": {
              "type": "ladder",
              "anchor": {
                "type": "fixed",
                "price": 99
              },
              "spacing": {
                "type": "abs",
                "value": 1
              },
              "count": 1,
              "direction": "down",
              "qty": 1,
              "takeProfit": {
                "type": "abs",
                "value": 1
              },
              "order": {
                "priceType": "LMT",
                "timeInForce": "ROD",
                "octype": "New"
              },
              "exitOrder": {
                "priceType": "LMT",
                "timeInForce": "ROD",
                "octype": "Cover"
              }
            },
            "cycle": {
              "rearmAfterExit": true,
              "maxCycles": null,
              "partialFill": "immediate"
            },
            "bounds": {
              "upper": null,
              "lower": null,
              "onBreakUpper": "none",
              "onBreakLower": "none"
            },
            "session": {
              "resumeRule": "confirm",
              "longDisconnectMs": 60000,
              "silentStallMs": 90000
            },
            "risk": {
              "maxWorkingEntries": null
            },
            "hooks": [],
            "intentSeq": 0,
            "issues": [],
            "createdAt": 0,
            "updatedAt": 0
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 1002,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 100
      },
      "expect": {
        "intents": [
          {
            "kind": "place",
            "key": "simulation/local-a/g1/L1/entry/0/0",
            "action": "Buy",
            "qty": 1,
            "leg": "entry",
            "role": "entry",
            "price": 99
          }
        ]
      }
    },
    {
      "event": {
        "type": "deal",
        "ts": 1003,
        "env": "simulation",
        "serverId": "local-a",
        "orderId": "o1",
        "eventId": null,
        "seq": "a1",
        "account": {
          "brokerId": "F002000",
          "accountId": "1234567"
        },
        "code": "TXFJ6",
        "action": "Buy",
        "qty": 1,
        "price": 99,
        "fillTs": 1.003,
        "seqno": "test-simulation/local-a/g1/L1/entry/0/0",
        "securityType": "FUT"
      },
      "expect": {
        "state": {
          "orphanDeals": [
