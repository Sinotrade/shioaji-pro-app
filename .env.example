# Copy this file to `.env` and fill in local-only values. NEVER commit `.env`.

# ── KGI bridge ───────────────────────────────────────────────────────
# The React app always talks to the local Python KGI bridge. Mock and real
# modes share the same frontend path.
VITE_KGI_MOCK=true
VITE_KGI_BACKEND_BASE=http://127.0.0.1:21323
# VITE_KGI_STREAM_BASE=http://127.0.0.1:21323

# ── KGI credentials (backend only; never exposed to the browser) ─────
# Do not prefix credentials with VITE_; Vite variables are public.
KGI_CLIENT_MODE=mock
KGI_PERSON_ID=
KGI_PERSON_PWD=
KGI_SIMULATION=false
# KGI_ACCOUNT=

# ── Frontend (optional) ──────────────────────────────────────────────
# Build-time public base path when deploying under a subpath.
# VITE_BASE=/apps/kgi-pro-app/

# Optional: Google Analytics 4. Used only for app_open + app_heartbeat,
# so GA Realtime can show active users in the last 5/30 minutes.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
